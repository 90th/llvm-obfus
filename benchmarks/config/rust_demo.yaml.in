frontend: rust
seed: @OBF_EFFECTIVE_BENCHMARK_SEED@
default_level: none
targets:
  - match: rust_protected_mix
    level: strong
string_encoding:
  authenticated_mode: true
  min_string_length: 1
  max_strings_per_module: 32
  prefer_lazy_decode: true
  allow_ctor_fallback: false
constant_encoding:
  max_constants_per_function: 4
  min_bit_width: 8
security:
  strip_release_markers: true
  fail_on_public_obf_symbol: true

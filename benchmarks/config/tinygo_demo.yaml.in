frontend: tinygo
seed: @OBF_EFFECTIVE_BENCHMARK_SEED@
default_level: none
targets:
  - match: tinygo_protected_value
    level: strong
string_encoding:
  max_strings_per_module: 0
constant_encoding:
  max_constants_per_function: 4
  min_bit_width: 8
security:
  strip_release_markers: true
  fail_on_public_obf_symbol: true

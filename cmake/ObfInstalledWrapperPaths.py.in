RUNTIME_ARCHIVE = str(_PACKAGE_LIB / "@OBF_INSTALLED_RUNTIME_NAME@")
DRIVER = str(_PACKAGE_BIN / "obf-driver@CMAKE_EXECUTABLE_SUFFIX@")
CHECKSUM_BINDER = str(_PACKAGE_BIN / "obf-checksum-bind@CMAKE_EXECUTABLE_SUFFIX@")
NATIVE_LINKER = str(_PACKAGE_BIN / "obf-native-link@CMAKE_EXECUTABLE_SUFFIX@")
MANAGED_LLD = str(_PACKAGE_BIN / "ld.lld")
PUBLIC_INCLUDE_DIR = str((_PACKAGE_BIN / @OBF_WRAPPER_INCLUDE_RELATIVE@).resolve())

target datalayout = "e-p:64:64-i64:64-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i64 @corruption_target(i64 %value) noinline optnone {
  %a = mul i64 %value, 37
  %b = add i64 %a, 11
  ret i64 %b
}
define i64 @proxy_corruption(i64 %value) noinline {
  %result = call i64 @corruption_target(i64 %value)
  ret i64 %result
}
define i32 @main() {
  %result = call i64 @proxy_corruption(i64 7)
  %wrong = icmp ne i64 %result, 270
  %exit = zext i1 %wrong to i32
  ret i32 %exit
}

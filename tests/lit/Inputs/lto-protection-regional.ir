target triple = "x86_64-unknown-linux-gnu"

@bias = internal global i32 0

define i32 @protected_calc(i32 %value) {
entry:
  %offset = load volatile i32, ptr @bias
  br label %region
region:
  %low = and i32 %value, 1
  %odd = icmp ne i32 %low, 0
  br i1 %odd, label %yes, label %no
yes:
  %y0 = xor i32 %value, 23130
  %y1 = add i32 %y0, 17
  %y2 = mul i32 %y1, 3
  br label %merge
no:
  %n0 = xor i32 %value, 23130
  %n1 = add i32 %n0, 18
  %n2 = mul i32 %n1, 3
  %n3 = sub i32 %n2, 3
  br label %merge
merge:
  %result = phi i32 [ %y2, %yes ], [ %n3, %no ]
  %total = add i32 %result, %offset
  ret i32 %total
}

define i32 @excluded_calc(i32 %value) noinline {
entry:
  %result = add i32 %value, 1234
  ret i32 %result
}

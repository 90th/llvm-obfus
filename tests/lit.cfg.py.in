import lit.formats
import shutil
import os
import platform
import re
import shlex
import subprocess
import sys

def _normalize_path(p):
    return str(p).replace("\\", "/") if p else p


def _shell_quote(val):
    return shlex.quote(str(val)) if (val is not None and str(val) != "") else ""


config.name = "llvm-obfus"
is_windows = sys.platform.startswith("win") or os.name == "nt"
if is_windows:
    git_bash = os.path.join(
        os.environ.get("ProgramFiles", r"C:\Program Files"), "Git", "bin", "bash.exe"
    )
    if not os.path.isfile(git_bash):
        lit_config.fatal(
            "Windows Lit requires Git for Windows Bash at {!r}.".format(git_bash)
        )
    # Lit otherwise falls back to cmd.exe on Windows. Pin its external shell to
    # Git for Windows so POSIX test commands such as `cmp` and `not` work.
    lit_config.bashPath = git_bash
    config.test_format = lit.formats.ShTest(execute_external=True)
else:
    config.test_format = lit.formats.ShTest(True)
config.suffixes = [".ll"]
config.test_source_root = _normalize_path("@CMAKE_CURRENT_SOURCE_DIR@/tests/lit")
config.test_exec_root = _normalize_path("@CMAKE_CURRENT_BINARY_DIR@/tests")

opt_path = _normalize_path("@LLVM_TOOLS_BINARY_DIR@/opt@CMAKE_EXECUTABLE_SUFFIX@")
if is_windows:
    opt_path = _normalize_path("@CMAKE_CURRENT_BINARY_DIR@/obf-opt.cmd")
filecheck_path = _normalize_path(
    "@LLVM_TOOLS_BINARY_DIR@/FileCheck@CMAKE_EXECUTABLE_SUFFIX@"
)
if is_windows:
    if not os.path.isfile(filecheck_path):
        filecheck_path = _normalize_path(
            shutil.which("FileCheck")
            or shutil.which("filecheck")
            or r"C:/Python314/Scripts/filecheck.exe"
        )
    if not filecheck_path:
        lit_config.fatal(
            "Windows Lit requires FileCheck in the configured LLVM tools directory "
            "or on PATH."
        )
config.substitutions.append(("%opt", _shell_quote(opt_path)))
config.substitutions.append(("%FileCheck", _shell_quote(filecheck_path)))
config.substitutions.append(("%python", _shell_quote(_normalize_path("@Python3_EXECUTABLE@"))))

# Try to find lli - not always available
lli_path = _normalize_path("@OBF_LLI@")
possible_paths = [
    lli_path if lli_path else None,
    _normalize_path("@LLVM_TOOLS_BINARY_DIR@/lli@CMAKE_EXECUTABLE_SUFFIX@"),
    shutil.which("lli"),
]

found_lli = None
for path in possible_paths:
    if path and os.path.exists(path):
        found_lli = path
        break

if found_lli:
    config.substitutions.append(
        ("%lli", f"{_shell_quote(_normalize_path(found_lli))} --extra-object={_shell_quote(_normalize_path('@CMAKE_CURRENT_BINARY_DIR@/obf_entropy_anchor.o'))} --extra-object={_shell_quote(_normalize_path('@CMAKE_CURRENT_BINARY_DIR@/obf_string_auth_runtime.o'))}")
    )
else:
    # lli not found - provide a dummy that will cause graceful test failure
    config.substitutions.append(
        ("%lli", _shell_quote(_normalize_path("lli@CMAKE_EXECUTABLE_SUFFIX@")))
    )

config.substitutions.append(
    ("%obf_plugin", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/obf_plugin@CMAKE_SHARED_MODULE_SUFFIX@")))
)
config.substitutions.append(
    ("%obf_driver", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/obf-driver@CMAKE_EXECUTABLE_SUFFIX@")))
)
config.substitutions.append(("%obf_clangxx", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/obf-clang++@CMAKE_EXECUTABLE_SUFFIX@"))))
config.substitutions.append(("%obf_clang", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/obf-clang@CMAKE_EXECUTABLE_SUFFIX@"))))
config.substitutions.append(("%raw_clang", _shell_quote(_normalize_path("@OBF_CLANG@"))))
config.substitutions.append(("%raw_clangxx", _shell_quote(_normalize_path("@OBF_CLANGXX@"))))
config.substitutions.append(("%obf_runtime", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/libobf_runtime.a"))))
config.substitutions.append(("%obf_build_include", _shell_quote(_normalize_path("@CMAKE_CURRENT_BINARY_DIR@/include"))))
checksum_bind_path = _normalize_path("@OBF_CHECKSUM_BIND@")
if checksum_bind_path and os.path.exists(checksum_bind_path):
    config.substitutions.append(("%obf_checksum_bind", _shell_quote(checksum_bind_path)))
    config.available_features.add("has-self-checksum-binder")
else:
    config.substitutions.append(("%obf_checksum_bind", "obf-checksum-bind"))




config.substitutions.append(("%cmake", _shell_quote(_normalize_path("@CMAKE_COMMAND@"))))
config.substitutions.append(("%llvm_host_triple", _shell_quote("@LLVM_HOST_TRIPLE@")))

wrapper_suffix = ".cmd" if (sys.platform.startswith("win") or os.name == "nt") else ""

config.substitutions.extend(
    [
        ("%obf_bc", _shell_quote(_normalize_path(f"@CMAKE_CURRENT_BINARY_DIR@/obf-bc{wrapper_suffix}"))),
        ("%obf_rustc", _shell_quote(_normalize_path(f"@CMAKE_CURRENT_BINARY_DIR@/obf-rustc{wrapper_suffix}"))),
        ("%obf_tinygo", _shell_quote(_normalize_path(f"@CMAKE_CURRENT_BINARY_DIR@/obf-tinygo{wrapper_suffix}"))),
        ("%raw_rustc", _shell_quote(_normalize_path("@OBF_RUSTC_COMMAND@"))),
        ("%raw_cargo", _shell_quote(_normalize_path("@OBF_CARGO_COMMAND@"))),
        ("%raw_zig", _shell_quote(_normalize_path("@OBF_ZIG_COMMAND@"))),
        ("%raw_tinygo", _shell_quote(_normalize_path("@OBF_TINYGO_COMMAND@"))),
        ("%llvm_nm", _shell_quote(_normalize_path("@OBF_NM@"))),
        ("%llvm_objdump", _shell_quote(_normalize_path("@OBF_OBJDUMP@"))),
        ("%llvm_strip", _shell_quote(_normalize_path("@OBF_STRIP@"))),
    ]
)


def _tool_output(command, *arguments):
    try:
        completed = subprocess.run(
            [command, *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            timeout=5,
            check=False,
        )
    except Exception:
        return None

    if completed.returncode != 0:
        return None
    return completed.stdout


if sys.platform.startswith("linux"):
    config.available_features.add("system-linux")
    if platform.machine().lower() in ("x86_64", "amd64"):
        config.available_features.add("system-linux-x86-64")

if is_windows:
    config.available_features.add("system-windows")
    if platform.machine().lower() in ("x86_64", "amd64"):
        config.available_features.add("system-windows-x86-64")

rust_version = _tool_output("@OBF_RUSTC_COMMAND@", "-Vv")
if rust_version is not None:
    rust_release = re.search(
        r"(?mi)^\s*release:\s*(\S+)",
        rust_version,
    )
    if rust_release and re.search(
        r"(?:^|[-.])(nightly|dev)(?:$|[-.])",
        rust_release.group(1),
    ):
        config.available_features.add("has-rust-nightly")

    expected_llvm = re.search(
        r"(\d+)\.(\d+)",
        "@LLVM_PACKAGE_VERSION@",
    )
    rust_llvm = re.search(
        r"(?mi)^\s*LLVM version:\s*(\d+)\.(\d+)(?:\.\d+)?",
        rust_version,
    )
    if expected_llvm and rust_llvm and expected_llvm.group(1, 2) == rust_llvm.group(1, 2):
        config.available_features.add("has-rust-llvm-match")

if _tool_output("@OBF_CARGO_COMMAND@", "--version") is not None:
    config.available_features.add("has-cargo")

zig_version = _tool_output("@OBF_ZIG_COMMAND@", "version")
if zig_version is not None and re.search(
    r"(?m)^\s*0\.16\.\d+(?:[-+][^\s]*)?\s*$",
    zig_version,
):
    config.available_features.add("has-zig-016")

lld_driver = shlex.split("@OBF_LLD_DRIVER@")
lld_version = _tool_output("@OBF_LLD_COMMAND@", *lld_driver, "--version")
if lld_version is not None and re.search(r"\bLLD\s+21(?:\.|$)", lld_version, re.IGNORECASE):
    config.available_features.add("has-lld-21")

host_elf_machines = {
    "x86_64": (62, 2),
    "amd64": (62, 2),
    "aarch64": (183, 2),
    "arm64": (183, 2),
    "armv5": (40, 1),
    "armv5l": (40, 1),
    "armv5tel": (40, 1),
    "armv7l": (40, 1),
    "armv6l": (40, 1),
    "arm": (40, 1),
    "armv6": (40, 1),
    "armv7": (40, 1),
    "armv8": (40, 1),
    "armv8l": (40, 1),
}
host_machine = platform.machine().lower()
llvm_host_triple = "@LLVM_HOST_TRIPLE@".lower()
llvm_host_arch = llvm_host_triple.split("-", 1)[0]
if (
    re.match(r"^21(?:\.|$)", "@LLVM_PACKAGE_VERSION@") is not None
    and sys.platform == "linux"
    and "linux" in llvm_host_triple
    and host_machine in host_elf_machines
    and llvm_host_arch in host_elf_machines
    and host_elf_machines[host_machine] == host_elf_machines[llvm_host_arch]
):
    config.available_features.add("has-tinygo-wrapper-host")


tinygo_version = _tool_output("@OBF_TINYGO_COMMAND@", "version")
if (
    "has-tinygo-wrapper-host" in config.available_features
    and tinygo_version is not None
    and re.search(
        r"\btinygo version\s+0\.41\.\d+(?:[-+][^\s]*)?(?=\s|$)",
        tinygo_version,
        re.IGNORECASE,
    )
    and re.search(
        r"\busing go version go1\.(?:23|24|25|26)(?:\.\d+)?(?:[-+][^\s)]*)?(?=\s|\))",
        tinygo_version,
        re.IGNORECASE,
    )
    and re.search(
        r"\bLLVM version\s+20\.\d+(?:\.\d+)?\b",
        tinygo_version,
        re.IGNORECASE,
    )
):
    config.available_features.add("has-tinygo-041-go-supported-llvm20")